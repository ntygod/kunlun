  "dialogue_registry": {
    "evt_ch14_dadu_settled": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "北行至大都，郭守敬收留了梁萧一行。柳莺莺已经戴笠远去；同行的空位提醒着众人，海上旧约仍未散去。"
    },
    "evt_ch14_dadu_settled_line_01": {
      "speaker": "郭守敬",
      "kind": "speech",
      "text": "梁老弟，若愿在太史院帮忙，名字不必张扬，算出的道理却可以堂堂正正留给天下人。"
    },
    "evt_ch14_dadu_settled_line_02": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "我只愿把所学用在不必伤人的地方。"
    },
    "evt_ch14_dadu_arrival_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "漏刻声中，众人安顿下来。幼童跟晓霜辨草，花生替院里搬运沉重仪器。"
    },
    "evt_ch14_calendar_setup": {
      "speaker": "郭守敬",
      "kind": "speech",
      "text": "四十尺高表的影缘模糊，景符小孔能把横梁细影定得清楚。先校影，再合各地测算，莫急着誊成定本。"
    },
    "evt_ch14_calendar_setup_line_01": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "农时差一分，百姓就多受一分辛苦。每一步都要留得下复核的凭据。"
    },
    "evt_ch14_k01_calendar": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "先看光斑与横梁的关系，不能拿一个背熟的数替代观察。"
    },
    "evt_ch14_k01_calendar_remembered": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "当年灵台的短表，如今成了太史院的高表。重差测影的道理仍要逐寸核对。"
    },
    "evt_ch14_calendar_completed": {
      "speaker": "郭守敬",
      "kind": "speech",
      "text": "三百六十五点二四二五日！以此数定岁实，终于能把各处记录合起来。"
    },
    "evt_ch14_calendar_completed_line_01": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "历法准一刻，便少误一季农桑。先生，这才是才学该去的地方。"
    },
    "evt_ch14_calendar_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "校勘稿与测影记录一同封存。"
    },
    "evt_ch14_clinic_arrival": {
      "speaker": "花晓霜",
      "kind": "speech",
      "text": "先替他们挡风、清出通路，再把药包按记号分开。赵昺，你替我记下谁还在等。"
    },
    "evt_ch14_clinic_arrival_line_01": {
      "speaker": "赵昺",
      "kind": "speech",
      "text": "我记得。每个人都有名字。"
    },
    "evt_ch14_clinic_completed": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "晓霜逐户安顿病人，花生替老人送回米粮。赵昺认真核对门牌，不让等候的人被遗忘。"
    },
    "evt_ch14_alley_clinic_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "晚间，太史院的灯还亮着。"
    },
    "evt_ch14_night_draft": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "这几处差数总合不上。我再算一遍。"
    },
    "evt_ch14_night_draft_line_01": {
      "speaker": "花晓霜",
      "kind": "speech",
      "text": "我陪你。算错的那页先别扔，明早也许还用得上。"
    },
    "evt_ch14_r01_draft": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "留着改过的痕迹，才能知道错在哪里。"
    },
    "evt_ch14_r01_draft_remembered": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "当年那本未合的算册，你也这样替我留着。如今再难，我不会先把错页撕了。"
    },
    "evt_ch14_night_companionship_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "冬雪退去，城中渐渐传来佛诞法会的消息。"
    },
    "evt_ch14_mother_recognized": {
      "speaker": "赵昺",
      "kind": "speech",
      "text": "娘！我是昺儿！你看看我！"
    },
    "evt_ch14_mother_recognized_line_01": {
      "speaker": "全太后",
      "kind": "speech",
      "text": "小施主认错人了……贫尼尘缘已尽，不识得什么昺儿。快走，莫平白丢了性命。"
    },
    "evt_ch14_mother_recognized_line_02": {
      "speaker": "花晓霜",
      "kind": "speech",
      "text": "她不是不认你，是怕有人盯着。先跟姐姐退到栏外。"
    },
    "evt_ch14_mother_recognized_line_03": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "全太后背过身去，攥紧的衣袖里落满眼泪。梁萧看见殿外密宗耳目正在靠近。"
    },
    "evt_ch14_festival_mother_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "释天风突然抢夺供果，香客惊散，九如现身护住人群。"
    },
    "evt_ch14_festival_pressure": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "花生，先护住孩子和老人。我戴上面具引开他们，别让人群挤倒。"
    },
    "evt_ch14_festival_pressure_line_01": {
      "speaker": "九如",
      "kind": "speech",
      "text": "梁小友，手下留人。"
    },
    "evt_ch14_festival_cleared": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "梁萧与九如合力解开追逐，把冲突引出香客之间。母子终究未能相认，赵昺仍望着尼庵的方向。"
    },
    "evt_ch14_festival_cover_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "孩子只想再看母亲一眼。众人商量夜里去无色庵探望。"
    },
    "evt_ch14_night_visit": {
      "speaker": "赵昺",
      "kind": "speech",
      "text": "我不叫她娘也成，我只想知道她过得好不好。"
    },
    "evt_ch14_night_visit_line_01": {
      "speaker": "花晓霜",
      "kind": "speech",
      "text": "我们轻轻进去，不惊动旁人。若不安全，就先回来。"
    },
    "evt_ch14_night_visit_line_02": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "只为探亲，不为争位。花生守住退路。"
    },
    "evt_ch14_nunnery_entry_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "侧院里忽然传来巨响，释天风追至，将一名士卒抛向九如。"
    },
    "evt_ch14_soldier_thrown": {
      "speaker": "九如",
      "kind": "speech",
      "text": "他也是一条命！"
    },
    "evt_ch14_soldier_thrown_line_01": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "九如接住士卒，却因此硬受一掌，气息顿挫。梁萧抢入院中，为众人解开围困。"
    },
    "evt_ch14_jiuru_injured": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "梁萧施展神仙倒解围，九如将士卒放到安全处，伤势却已难以再战。"
    },
    "evt_ch14_jiuru_injured_line_01": {
      "speaker": "花生",
      "kind": "speech",
      "text": "师父，俺扶你！"
    },
    "evt_ch14_nunnery_rescue_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "烟雾从暗廊涌来。梁萧回首时，晓霜与幼童所在的石阶已空。"
    },
    "evt_ch14_xiaoshuang_abducted": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "密宗影卫借乱掳走晓霜与赵昺，只留下半枚玉罗汉。晓霜与众人失散，只能设法追踪救回。"
    },
    "evt_ch14_xiaoshuang_abducted_line_01": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "花生，送九如大师到安全处，再同我去大天王寺。"
    },
    "evt_ch14_xiaoshuang_abducted_line_02": {
      "speaker": "九如",
      "kind": "speech",
      "text": "老衲赴不了约了。花生，你代我去。破阵救人，不可杀戮无辜。"
    },
    "evt_ch14_abduction_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "花生收紧袈裟，向寺门走去。"
    },
    "evt_ch14_gate_blocked": {
      "speaker": "花生",
      "kind": "speech",
      "text": "快把晓霜姐姐和孩子放出来！"
    },
    "evt_ch14_gate_blocked_line_01": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "门可破，人不可伤。先看清狮台受力，再抬。"
    },
    "evt_ch14_stone_lion_mastered": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "花生举狮撞开铜门，震地之力在一声长喝中贯通。伏魔大金刚震基础式正式掌握，尚未靠合招代替破阵。"
    },
    "evt_ch14_temple_gate_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "前殿金刚杵阵已列开，梁萧与花生停下整备。"
    },
    "evt_ch14_temple_loadout_committed": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "阵中僧人并非该死之人，失去战力便停手。"
    },
    "evt_ch14_temple_loadout_committed_line_01": {
      "speaker": "花生",
      "kind": "speech",
      "text": "俺记着。先破兵刃，再找阵眼。"
    },
    "evt_ch14_temple_loadout_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "护法上师合十，铜轮深处传出沉重的转动声。"
    },
    "evt_ch14_b11_completed": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "守寺僧人失去战力而未丧命，四座铜轮崩落。梁萧与花生收势停手；兄弟终于能将九宫巨灵之势合而为一。"
    },
    "evt_ch14_temple_battle_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "内殿的门缓缓打开，八思巴端坐莲花座上。"
    },
    "evt_ch14_dharma_question": {
      "speaker": "八思巴",
      "kind": "speech",
      "text": "万法归一，天下归元，苍生方免兵燹。施主何苦逆天而行？"
    },
    "evt_ch14_dharma_question_line_01": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "若所谓归一只是百姓的白骨，我不能把这样的答案称作慈悲。"
    },
    "evt_ch14_dharma_answered": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "国师说万法归一，那一又归于何处？"
    },
    "evt_ch14_dharma_answered_line_01": {
      "speaker": "八思巴",
      "kind": "speech",
      "text": "一归万有，一归真如。"
    },
    "evt_ch14_dharma_answered_line_02": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "若归一的代价是千万无辜化作焦土，那一归之所便不是慈悲。"
    },
    "evt_ch14_dharma_answered_line_03": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "水汽与灯火所成的法相散去。八思巴拨珠的手停了下来。"
    },
    "evt_ch14_dharma_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "八思巴合十长叹，命人解开幼童的绳索。"
    },
    "evt_ch14_emperor_released": {
      "speaker": "赵昺",
      "kind": "speech",
      "text": "梁叔叔！晓霜姐姐被断臂的人带走了！"
    },
    "evt_ch14_emperor_released_line_01": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "花生，先把他送回九如大师身边。我问清晓霜下落便来。"
    },
    "evt_ch14_emperor_released_line_02": {
      "speaker": "八思巴",
      "kind": "speech",
      "text": "晓霜姑娘已被萧冷带往西山。老衲欠他旧恩，不得不留施主片刻。"
    },
    "evt_ch14_emperor_released_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "梁萧抬头，殿外又有身影封住归路。"
    },
    "evt_ch14_relay_pressure": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "为偿萧冷昔年的救命之恩，八思巴继续以密宗车轮相困。梁萧担心晓霜，接连应对，已无暇调息。他只想尽快脱身，去找晓霜。"
    },
    "evt_ch14_liang_captured": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "车轮相困终于耗尽梁萧余力。萧冷趁隙制住他，将他带往紫竹林。花生与幼童已经离寺，殿中只剩他一人。"
    },
    "evt_ch14_wheel_capture_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "车轮碾过雪泥，西山紫竹渐渐遮住天光。"
    },
    "evt_ch14_mother_reunited": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "娘……萧儿找了你整整十年。"
    },
    "evt_ch14_mother_reunited_line_01": {
      "speaker": "萧玉翎",
      "kind": "speech",
      "text": "萧儿，你都长这么大了。快走，别再为我陷在这里。"
    },
    "evt_ch14_mother_reunited_line_02": {
      "speaker": "萧冷",
      "kind": "speech",
      "text": "玉翎师妹，我只是想逼你离开这座牢笼……"
    },
    "evt_ch14_mother_reunited_line_03": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "晓霜受制于石坛旁。萧玉翎苍白的鬓角与颤抖的手，让梁萧看清这十年并无安稳富贵。"
    },
    "evt_ch14_zizhu_reunion_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "林梢一声冷笑，萧千绝落在石碑前。"
    },
    "evt_ch14_father_truth_revealed": {
      "speaker": "萧千绝",
      "kind": "speech",
      "text": "三赌虽让梁文靖赢去半招，老夫最后一掌已把阴劲打入他心脉。他苟延几年，不过是掌下一缕孤魂。"
    },
    "evt_ch14_father_truth_revealed_line_01": {
      "speaker": "萧玉翎",
      "kind": "speech",
      "text": "师父……你竟一直骗我！"
    },
    "evt_ch14_father_truth_revealed_line_02": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "爹不是病死的。你杀我生父，又让娘为你守了十年毒誓！"
    },
    "evt_ch14_father_truth_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "母亲先设法解开晓霜受制的穴道，林中对峙已无法挽回。"
    },
    "evt_ch14_xiaoshuang_freed": {
      "speaker": "萧玉翎",
      "kind": "speech",
      "text": "晓霜，快离开掌风！"
    },
    "evt_ch14_xiaoshuang_freed_line_01": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "萧玉翎救下晓霜。梁萧与萧千绝却已被旧仇推向决死相搏；晓霜虽重获自由，却来不及插入两人之间。"
    },
    "evt_ch14_duel_converged": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "归藏剑意、阴阳流与碧海六劲交织。百余合的对峙收束为两股决死掌力，谁都未肯退让。"
    },
    "evt_ch14_zizhu_duel_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "萧玉翎看见儿子与师父即将同归于尽，纵身冲入二人之间。"
    },
    "evt_ch14_mother_struck": {
      "speaker": "萧玉翎",
      "kind": "speech",
      "text": "不要——！"
    },
    "evt_ch14_mother_struck_line_01": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "两股掌风同时击中萧玉翎。白光一闪，她倒入梁萧怀中。掌力来自儿子与师父两方，已经无法收回。"
    },
    "evt_ch14_mother_struck_line_02": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "娘！我不要报仇了，我带你回华山！"
    },
    "evt_ch14_mother_intervenes_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "母亲攥住梁萧的手，余下的话已轻得几乎听不见。"
    },
    "evt_ch14_mother_last_words": {
      "speaker": "萧玉翎",
      "kind": "speech",
      "text": "萧儿……答应娘，不要再向师父报仇。不要让这条仇恨的路再走下去。"
    },
    "evt_ch14_mother_last_words_line_01": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "娘，我听你的。你别走。"
    },
    "evt_ch14_mother_died": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "萧玉翎含泪而逝。梁萧抱紧她渐冷的身体，方才所有求胜之念尽成空白。"
    },
    "evt_ch14_mother_vow_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "萧冷望着玉翎的遗体，终于看清自己的执念害了谁。"
    },
    "evt_ch14_xiao_leng_died": {
      "speaker": "萧冷",
      "kind": "speech",
      "text": "玉翎师妹，是我害了你。"
    },
    "evt_ch14_xiao_leng_died_line_01": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "萧冷在悔恨中自尽，竹叶落下，遮住了地上的刀影。萧千绝顷刻白头，僵立无言。"
    },
    "evt_ch14_xiao_leng_end_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "梁萧抱着母亲，眼中的生气一点点沉下去。晓霜迈过碎竹，走到他身前。"
    },
    "evt_ch14_despair": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "阿雪、三狗、娘……我这一身才学，究竟护住了谁。"
    },
    "evt_ch14_despair_line_01": {
      "speaker": "花晓霜",
      "kind": "speech",
      "text": "梁萧哥哥，看着我。你娘舍下性命救你，不是要你随她而去。先把剑交给我。"
    },
    "evt_ch14_qianjue_departed": {
      "speaker": "花晓霜",
      "kind": "speech",
      "text": "萧千绝，你赢了武功，却把身边的人一个个逼走。天下第一，不能抵一个活人的性命！"
    },
    "evt_ch14_qianjue_departed_line_01": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "萧千绝失魂退入风雪。晓霜留下，始终守在梁萧身边；不再让任何人以仇恨逼迫他。"
    },
    "evt_ch14_break_blade_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "风声掠过竹梢，长夜仍未过去。"
    },
    "evt_ch14_vigil_words": {
      "speaker": "花晓霜",
      "kind": "speech",
      "text": "你愿意护人，便和我一起走。往后看见一个受苦的人，我们就尽力帮一个。今晚先让我陪着你。"
    },
    "evt_ch14_vigil_words_line_01": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "晓霜缓缓走近，蹲下握住梁萧冰冷的双手。她没有追问，也没有催促，只让他知道身边仍有人陪着。"
    },
    "evt_ch14_dawn_vow": {
      "speaker": "梁萧",
      "kind": "speech",
      "text": "我不再寻仇。往后的路，与你一道护人。"
    },
    "evt_ch14_dawn_vow_line_01": {
      "speaker": "花晓霜",
      "kind": "speech",
      "text": "好。今天先走一步，明天再走一步。"
    },
    "evt_ch14_dawn_vigil_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "晨曦照上断竹，远处传来花生与九如的脚步。"
    },
    "evt_ch14_southbound_ready": {
      "speaker": "花生",
      "kind": "speech",
      "text": "大哥，俺替你抬。俺力气大，走得稳。"
    },
    "evt_ch14_southbound_ready_line_01": {
      "speaker": "九如",
      "kind": "speech",
      "text": "回去吧，扶你母亲南归入土为安。"
    },
    "evt_ch14_southbound_ready_line_02": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "幼童由九如照护，众人准备扶柩南归。家乡的墓地还在远方，下一程要带母亲回到父亲身边。"
    },
    "evt_ch14_chapter_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "第十四章行旅归档。母亲与萧冷长眠，柳莺莺仍在自己的归途。梁萧与晓霜带着止仇之誓走向天明。"
    },
    "evt_ch14_southbound_complete": {
      "speaker": "旁白",
      "kind": "stage",
      "text": "南归路长。这不是整个故事的终点。"
    }
  },
