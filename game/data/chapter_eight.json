  "dialogue_registry": {
    "dlg_ch08_arrival": {
      "speaker": "旁白",
      "text": "汉水舟阵相接，二张带粮突围，云殊操阵守台。阿雪仍在营中养伤；梁萧独自登舟。"
    },
    "dlg_ch08_river_rules": {
      "speaker": "旁白",
      "text": "这是守台交锋，不以杀死云殊为目标。独立交锋开场真气充满；可观察长篙蓄势，借公开矢石掩体移步。"
    },
    "dlg_ch08_supply": {
      "speaker": "旁白",
      "text": "其余宋军粮舟仍将粮甲送入城中。眼前一次射击没有改变这场运粮的战略结果。"
    },
    "dlg_ch08_ranya_beads": {
      "speaker": "旁白",
      "text": "兰娅颈间佩着一串蓝宝石星珠，并非梁萧从前射断的珍珠。她把珠盘、渠池筹与木尺放在案上。"
    },
    "dlg_ch08_ranya_promise": {
      "speaker": "兰娅",
      "text": "算道不只有一种写法。若有机会，到马拉加来，我们还可接着谈。药方与这点白瓷膏先留给你，疗养须慢慢来。"
    },
    "dlg_ch08_hook_net": {
      "speaker": "旁白",
      "text": "革囊撞上金钩网，旧法不成。两月军令压在肩上，郭守敬来到水边，与兰娅同看流向。"
    },
    "dlg_ch08_medicine": {
      "speaker": "梁萧",
      "text": "赏赐我只求半年所需药材。"
    },
    "dlg_ch08_medicine_after": {
      "speaker": "旁白",
      "text": "药材与药方一同收妥，只供长期疗养，不会立刻治好旧伤。"
    },
    "dlg_ch08_fancheng": {
      "speaker": "旁白",
      "text": "樊城初攻告破，军队随后转向襄阳。两城之间仍隔着汉水，不能把一处战果当作两城尽下。"
    },
    "dlg_ch08_xiangyang": {
      "speaker": "旁白",
      "text": "襄阳天罡弩反制炮阵，梁萧护住阿雪退离危险处。她仍非战斗成员，叙事中的伤势不另扣气血。"
    },
    "dlg_ch08_siege_rules": {
      "speaker": "旁白",
      "text": "独立战役首次开场充满真气。三处枢纽共属同一弩台；校准和发射都占一回合。战役中场保留真气、调息、用药次数与格物层。"
    },
    "dlg_ch08_alley_window": {
      "speaker": "旁白",
      "text": "弩台已经失效，总攻尚未确认。襄阳城外受波及的巷道里传来呼救，可以先往查看。"
    },
    "dlg_ch08_fire_disaster": {
      "speaker": "旁白",
      "text": "弩失效后炮位前移，重弹引燃火库。火势失控蔓延民居，军令的后果不因口吻不同而消失。"
    },
    "dlg_ch08_ruins": {
      "speaker": "旁白",
      "text": "梁萧缓步走过焦黑街巷。孤儿哭声与抱着死婴的老妇留在残垣间；她不是先前巷道里的刘婆婆。"
    },
    "dlg_ch08_punishment": {
      "speaker": "旁白",
      "text": "梁萧顶撞军令，受四十军棍。伤痛留在叙事里，不新增数值扣血，也不借此复活。"
    },
    "dlg_ch08_surrender": {
      "speaker": "旁白",
      "text": "阿里海牙折箭允诺受降。约定已经议定，城门尚未正式开启。"
    },
    "dlg_ch08_yang": {
      "speaker": "旁白",
      "text": "杨榷已经死去，伤痕指向归藏剑。未编完的竹蚂蚱从他的遗物中交到梁萧手里，只这一件。"
    },
    "dlg_ch08_six_friends": {
      "speaker": "旁白",
      "text": "李庭、王可、土土哈、囊古歹，与赵山、杨榷的名字一同浮上心头。昔日手印是回忆，不能把亡友叫回此刻。"
    },
    "dlg_ch08_departure": {
      "speaker": "旁白",
      "text": "兰娅随陆路商队西行，将原先佩着的蓝宝石星珠留在枯枝旁。"
    },
    "dlg_ch08_archive": {
      "speaker": "旁白",
      "text": "天色渐明，襄阳正式开城。梁萧收起竹蚂蚱，灾难与受降都不会因归档而被抹去。"
    }
  },
