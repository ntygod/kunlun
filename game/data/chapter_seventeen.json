        "06:MQ-17 Step1"
      ],
      "status": "adapted_development_script"
    },
    "ch17_merchants_01": {
      "speaker": "阿莫",
      "text": "小人识得通往天山的路。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-01",
        "06:MQ-17 Step1"
      ],
      "status": "adapted_development_script"
    },
    "ch17_feng_return_00": {
      "speaker": "旁白",
      "text": "火流星踏过沙梁。风怜抱着羊皮剑匣，踉跄停在梁萧面前。",
      "kind": "stage",
      "source_refs": [
        "04:SC-17-01",
        "06:MQ-17 Step1"
      ],
      "status": "adapted_development_script"
    },
    "ch17_feng_return_01": {
      "speaker": "风怜",
      "text": "找了六年，终于找到你。欧龙子爷爷、铁哲大叔都不在了，剑却铸成了。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-01",
        "06:MQ-17 Step1"
      ],
      "status": "adapted_development_script"
    },
    "ch17_refuse_sword_00": {
      "speaker": "梁萧",
      "text": "人命至重，怎能为一柄剑轻掷？先由你收好，我们带商队出去。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-01",
        "06:MQ-17 Step1"
      ],
      "status": "adapted_development_script"
    },
    "ch17_howls_00": {
      "speaker": "旁白",
      "text": "东西两谷的狼哨几乎同时响起。风怜护住剑匣，梁萧挡在商队前方。",
      "kind": "stage",
      "source_refs": [
        "04:SC-17-01",
        "06:MQ-17 Step2",
        "combat_rules:MQ17.encounter_xp"
      ],
      "status": "adapted_development_script"
    },
    "ch17_zhuque_00": {
      "speaker": "旁白",
      "text": "朱雀亦已遇害。彩凤循狼哨追来，误将梁萧当作凶手；风怜伸手护住剑匣。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-17 Step2"
      ],
      "status": "adapted_development_script"
    },
    "ch17_chief_00": {
      "speaker": "彩凤",
      "text": "朱雀刚刚遇害，怎能放陌生人进村！",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-02",
        "06:MQ-17 Step2"
      ],
      "status": "adapted_development_script"
    },
    "ch17_chief_01": {
      "speaker": "柳莺莺",
      "text": "把兵刃放下。先救人，再把事情查清。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-02",
        "06:MQ-17 Step2"
      ],
      "status": "adapted_development_script"
    },
    "ch17_chief_02": {
      "speaker": "旁白",
      "text": "柳莺莺与梁萧隔着雪地相望，谁也没有立刻走近。",
      "kind": "stage",
      "source_refs": [
        "04:SC-17-02",
        "06:MQ-17 Step2"
      ],
      "status": "adapted_development_script"
    },
    "ch17_reunion_echo_00": {
      "speaker": "梁萧",
      "text": "莺莺，十年不见。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-02",
        "06:MQ-17 Step2"
      ],
      "status": "adapted_development_script"
    },
    "ch17_reunion_echo_01": {
      "speaker": "柳莺莺",
      "text": "远道的客人先歇脚。村里的事，我还得去看。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-02",
        "06:MQ-17 Step2"
      ],
      "status": "adapted_development_script"
    },
    "ch17_chief_after_00": {
      "speaker": "柳莺莺",
      "text": "这里的老小把命托给了我，便不是一句安慰能了的。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-02",
        "06:MQ-17 Step3"
      ],
      "status": "adapted_development_script"
    },
    "ch17_chief_after_01": {
      "speaker": "梁萧",
      "text": "这里的主人，确实当得起。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-02",
        "06:MQ-17 Step3"
      ],
      "status": "adapted_development_script"
    },
    "ch17_roof_offer_00": {
      "speaker": "旁白",
      "text": "西侧还有一家人住在漏风的帐篷里。柳莺莺指向已备好的红松木。",
      "kind": "stage",
      "source_refs": [
        "06:R07"
      ],
      "status": "adapted_development_script"
    },
    "ch17_before_patrol_00": {
      "speaker": "柳莺莺",
      "text": "山后的狼哨还没有停，我们先把村外的威胁查清。",
      "kind": "speech",
      "source_refs": [
        "06:R07"
      ],
      "status": "adapted_development_script"
    },
    "ch17_double_appears_00": {
      "speaker": "旁白",
      "text": "披狼皮的人率群狼堵住雪谷。柳莺莺望见铁爪套下露出的衣袖。",
      "kind": "stage",
      "source_refs": [
        "07:B13 phase1",
        "04:SC-17-03"
      ],
      "status": "adapted_development_script"
    },
    "ch17_double_dead_00": {
      "speaker": "旁白",
      "text": "狼皮撕开，众人方知这只是替身。商队方向传来不祥的静寂。",
      "kind": "stage",
      "source_refs": [
        "07:B13 phase1",
        "04:SC-17-03"
      ],
      "status": "adapted_development_script"
    },
    "ch17_caravan_silence_00": {
      "speaker": "旁白",
      "text": "塔波罗与同行者已遭灭口。只剩阿莫自称侥幸逃生。",
      "kind": "stage",
      "source_refs": [
        "06:PZ-08 evidence3/4"
      ],
      "status": "adapted_development_script"
    },
    "ch17_deduction_00": {
      "speaker": "旁白",
      "text": "六处线索都已记下。猜疑不能替代证据；把两条因果链分清，再指认真凶。",
      "kind": "stage",
      "source_refs": [
        "06:PZ-08 evidence5"
      ],
      "status": "adapted_development_script"
    },
    "ch17_hostage_00": {
      "speaker": "阿莫",
      "text": "再向前一步，便试试这丫头能不能活！",
      "kind": "speech",
      "source_refs": [
        "07:B13 phase2",
        "04:SC-17-03",
        "06:MQ-17 Step5"
      ],
      "status": "adapted_development_script"
    },
    "ch17_hostage_01": {
      "speaker": "旁白",
      "text": "风怜的退路被封。柳莺莺握住软索，梁萧的手停在剑匣旁。",
      "kind": "stage",
      "source_refs": [
        "07:B13 phase2",
        "04:SC-17-03",
        "06:MQ-17 Step5"
      ],
      "status": "adapted_development_script"
    },
    "ch17_sword_after_00": {
      "speaker": "旁白",
      "text": "天罚锈壳脱落。梁萧收住剑势，众人才敢走近倒在雪中的风怜。",
      "kind": "stage",
      "source_refs": [
        "07:B13 phase2",
        "04:SC-17-03",
        "06:MQ-17 Step5"
      ],
      "status": "adapted_development_script"
    },
    "ch17_sword_after_01": {
      "speaker": "梁萧",
      "text": "剑归匣中。先看风怜的伤。",
      "kind": "speech",
      "source_refs": [
        "07:B13 phase2",
        "04:SC-17-03",
        "06:MQ-17 Step5"
      ],
      "status": "adapted_development_script"
    },
    "ch17_burial_silence_00": {
      "speaker": "旁白",
      "text": "雪地里没有战利品的欢呼。柳莺莺为孤儿拢好衣领，转身走向村中。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-17 Step6"
      ],
      "status": "adapted_development_script"
    },
    "ch17_close_roof_00": {
      "speaker": "旁白",
      "text": "去往湖畔之前，柳莺莺把村中分工重新交代了一遍。",
      "kind": "stage",
      "source_refs": [
        "06:R07 deadline"
      ],
      "status": "adapted_development_script"
    },
    "ch17_shave_00": {
      "speaker": "柳莺莺",
      "text": "坐好，别乱动。十年风沙，都挂在胡子上了。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-04",
        "06:MQ-17 Step6"
      ],
      "status": "adapted_development_script"
    },
    "ch17_shave_01": {
      "speaker": "梁萧",
      "text": "有劳柳大首领。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-04",
        "06:MQ-17 Step6"
      ],
      "status": "adapted_development_script"
    },
    "ch17_shave_02": {
      "speaker": "旁白",
      "text": "刀锋收起，十年前的争执留在湖风里。",
      "kind": "stage",
      "source_refs": [
        "04:SC-17-04",
        "06:MQ-17 Step6"
      ],
      "status": "adapted_development_script"
    },
    "ch17_lake_farewell_00": {
      "speaker": "柳莺莺",
      "text": "去寻晓霜吧。我有我的小禽村。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-04",
        "06:MQ-17 Step6"
      ],
      "status": "adapted_development_script"
    },
    "ch17_apprentice_00": {
      "speaker": "风怜",
      "text": "我不求做英雄的妻子。我想学算学、机关与剑法，保护自己的族人。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-04",
        "06:MQ-17 Step6"
      ],
      "status": "adapted_development_script"
    },
    "ch17_apprentice_01": {
      "speaker": "梁萧",
      "text": "愿学，便也要敢问、敢辨是非。",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-04",
        "06:MQ-17 Step6"
      ],
      "status": "adapted_development_script"
    },
    "ch17_apprentice_02": {
      "speaker": "柳莺莺",
      "text": "好徒弟就在眼前，还端什么架子？",
      "kind": "speech",
      "source_refs": [
        "04:SC-17-04",
        "06:MQ-17 Step6"
      ],
      "status": "adapted_development_script"
    },
    "ch17_ending_00": {
      "speaker": "旁白",
      "text": "山村的灯火留在身后。风怜背着剑匣，第一次以弟子的身份随梁萧走向中土。",
      "kind": "stage",
      "source_refs": [
        "04:SC-17-04",
        "06:MQ-17 Step6"
      ],
      "status": "adapted_development_script"
    },
    "ch17_r07_accept_00": {
      "speaker": "柳莺莺",
      "text": "屋子要由我们一起盖。我定分工，你们来帮手。",
      "kind": "speech",
      "source_refs": [
        "06:R07"
      ],
      "status": "adapted_development_script"
    },
    "ch17_r07_after_00": {
      "speaker": "梁萧",
      "text": "这天山的主人，你当之无愧。",
      "kind": "speech",
      "source_refs": [
        "06:R07"
      ],
      "status": "adapted_development_script"
    },
    "ch17_r07_after_01": {
      "speaker": "柳莺莺",
      "text": "少来酸书生客套。替我把晓霜妹子找回来。",
      "kind": "speech",
      "source_refs": [
        "06:R07"
      ],
      "status": "adapted_development_script"
    }
  },
