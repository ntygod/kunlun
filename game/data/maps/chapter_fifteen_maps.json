            },
            {
              "anchor": "grave",
              "label": "安放母柩，与父合葬",
              "verb": "lay_coffin",
              "feedback": "父母从此同眠此地，没有新的战利品。"
            },
            {
              "anchor": "stone",
              "label": "在空白处刻下靖字",
              "verb": "inscribe_jing",
              "feedback": "梁萧握稳剑柄，端端正正补上一个靖字。"
            },
            {
              "anchor": "shelter",
              "label": "收好工具，准备守孝",
              "verb": "prepare_mourning",
              "feedback": "晓霜与幼帝收拢用具，墓前归于安静。"
            }
          ]
        },
        "world_ch15_tomb_triage": {
          "label": "襄樊归墓",
          "scene_id": "ch15_tomb_return",
          "control_actor_id": "char_hua_xiaoshuang",
          "visible_actor_ids": [
            "char_hua_xiaoshuang",
            "char_huasheng",
            "npc_zhao_bing",
            "npc_xiao_qianjue",
            "npc_ch15_wubao"
          ],
          "entry_anchor": "entry",
          "constrained": false,
          "steps": [
            {
              "anchor": "stone",
              "label": "辨认碑上的靖字",
              "verb": "read_gravestone",
              "feedback": "碑字仍在，梁萧已不在此处。"
            },
            {
              "anchor": "patient",
              "label": "询问来者的近况",
              "verb": "hear_travellers",
              "feedback": "晓霜先听清来者的处境，不因衣着门第轻慢。"
            },
            {
              "anchor": "elder",
              "label": "向白头老人问讯",
              "verb": "speak_elder",
              "feedback": "萧千绝守在墓旁，晓霜以礼相问。"
            },
            {
              "anchor": "shelter",
              "label": "安排幼帝在避风处等候",
              "verb": "shelter_child",
              "feedback": "花生与晓霜照应幼帝，东线由他们自己作主。"
            }
          ]
        },
        "world_ch15_postbattle_care": {
          "label": "墓旁医护",
          "scene_id": "ch15_treatment",
          "control_actor_id": "char_hua_xiaoshuang",
