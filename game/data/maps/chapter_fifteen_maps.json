          "constrained": false,
          "steps": [
            {
              "anchor": "shelter",
              "label": "取来清洁包扎用具",
              "verb": "collect_bundle",
              "feedback": "备妥故事中的照护用具，不展示现实配药操作。"
            },
            {
              "anchor": "patient",
              "label": "照看中条五宝",
              "verb": "care_treasures",
              "feedback": "伤者各得安置，轻重缓急由晓霜判断。"
            },
            {
              "anchor": "elder",
              "label": "将照护送到萧千绝身边",
              "verb": "care_elder",
              "feedback": "恩怨不改变病人的身份，老人默然接受照护。"
