  "dialogue_registry": {
    "ch16_entry_line_00": {
      "speaker": "旁白",
      "text": "黄河决口，粮仓却紧闭着。梁萧收住向西的脚步。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step1",
        "04:SC-16-01"
      ],
      "status": "adapted_development_script"
    },
    "ch16_entry_line_01": {
      "speaker": "治水老人",
      "text": "堤下还有人，莫先与水争强。",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step1",
        "04:SC-16-01"
      ],
      "status": "adapted_development_script"
    },
    "ch16_relief_line_00": {
      "speaker": "旁白",
      "text": "粮食交给灾民分发。梁萧走向洪水冲刷的旧堤。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step1",
        "04:SC-16-01"
      ],
      "status": "adapted_development_script"
    },
    "ch16_river_survey_line_00": {
      "speaker": "旁白",
      "text": "来水十成，北渠与中渠各承四成；南渠名为二成，淤泥却堵去一半。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step1",
        "04:SC-16-01",
        "06:PZ-07 river"
      ],
      "status": "adapted_development_script"
    },
    "ch16_river_survey_line_01": {
      "speaker": "梁萧",
      "text": "少的一成，不该压给下游的人。",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step1",
        "04:SC-16-01",
        "06:PZ-07 river"
      ],
      "status": "adapted_development_script"
    },
    "ch16_river_after_line_00": {
      "speaker": "旁白",
      "text": "旧河道接去最后一成洪峰。梁萧离开时，没有人在问他是哪国人。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step1",
        "04:SC-16-01",
        "06:PZ-07 river"
      ],
      "status": "adapted_development_script"
    },
    "ch16_home_silence_line_00": {
      "speaker": "旁白",
      "text": "灶火早冷，灰尘盖住木凳。这里没有等候他回家的脚步声。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step1",
        "04:SC-16-01"
      ],
      "status": "adapted_development_script"
    },
    "ch16_home_echo_line_00": {
      "speaker": "旁白",
      "text": "檐下只剩风声。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step1",
        "04:SC-16-01"
      ],
      "status": "adapted_development_script"
    },
    "ch16_source_realization_line_00": {
      "speaker": "梁萧",
      "text": "一溪微弱，百溪会合，却能穿山越石。",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step2",
        "07:LX_A06"
      ],
      "status": "adapted_development_script"
    },
    "ch16_source_realization_line_01": {
      "speaker": "旁白",
      "text": "他不再以强力截断水路，而顺着细流的来势，一一接引。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step2",
        "07:LX_A06"
      ],
      "status": "adapted_development_script"
    },
    "ch16_feng_danger_line_00": {
      "speaker": "旁白",
      "text": "城外沙路上，少女被恶徒逼得无路可退。梁萧横身隔开刀锋。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step3",
        "04:SC-16-02"
      ],
      "status": "adapted_development_script"
    },
    "ch16_feng_name_line_00": {
      "speaker": "风怜",
      "text": "我叫风怜。你从哪里来？",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step3",
        "04:SC-16-02"
      ],
      "status": "adapted_development_script"
    },
    "ch16_feng_name_line_01": {
      "speaker": "梁萧",
      "text": "西昆仑，无国无家之人。",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step3",
        "04:SC-16-02"
      ],
      "status": "adapted_development_script"
    },
    "ch16_raid_warning_line_00": {
      "speaker": "旁白",
      "text": "海都叛军冲入绿洲。火光里传来孩子的哭声，梁萧停下离去的脚步。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step3",
        "07:LX_A06"
      ],
      "status": "adapted_development_script"
    },
    "ch16_raid_ready_line_00": {
      "speaker": "梁萧",
      "text": "退到屋后。这里交给我。",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step3",
        "07:LX_A06"
      ],
      "status": "adapted_development_script"
    },
    "ch16_raid_aftermath_line_00": {
      "speaker": "旁白",
      "text": "阿鲁台倒下，绿洲的火光却没有立刻熄灭。没有欢呼，只有寻找亲人的呼喊。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step3",
        "07:LX_A06",
        "combat_rules:MQ16.encounter_xp"
      ],
      "status": "adapted_development_script"
    },
    "ch16_funeral_vow_line_00": {
      "speaker": "梁萧",
      "text": "救得了一时，若只以杀止杀，何处才是尽头？",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step4",
        "04:SC-16-02"
      ],
      "status": "adapted_development_script"
    },
    "ch16_funeral_vow_line_01": {
      "speaker": "风怜",
      "text": "活着的人还在等明日。",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step4",
        "04:SC-16-02"
      ],
      "status": "adapted_development_script"
    },
    "ch16_sword_offer_line_00": {
      "speaker": "捷苏",
      "text": "可敢再较一次高下？",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step4",
        "04:SC-16-02"
      ],
      "status": "adapted_development_script"
    },
    "ch16_sword_offer_line_01": {
      "speaker": "欧龙子",
      "text": "若以此剑斩断天机宫之剑，名剑与婚约，皆可成全。",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step4",
        "04:SC-16-02"
      ],
      "status": "adapted_development_script"
    },
    "ch16_sword_offer_line_02": {
      "speaker": "旁白",
      "text": "炉旁仍是未竟的剑胎。梁萧没有伸手接剑。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step4",
        "04:SC-16-02"
      ],
      "status": "adapted_development_script"
    },
    "ch16_ranya_reunion_line_00": {
      "speaker": "兰娅",
      "text": "父亲没有等到你。可他留下的门，还在。",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step5",
        "04:SC-16-03"
      ],
      "status": "adapted_development_script"
    },
    "ch16_ranya_reunion_line_01": {
      "speaker": "旁白",
      "text": "梁萧垂首，在纳速拉丁留下的书案前停了很久。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step5",
        "04:SC-16-03"
      ],
      "status": "adapted_development_script"
    },
    "ch16_scale_inscription_line_00": {
      "speaker": "旁白",
      "text": "黄金王冠、古老手稿与大马士革长剑摆在铜盘下。石门问：何物最重？",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step5",
        "06:PZ-07 scale",
        "04:SC-16-03"
      ],
      "status": "adapted_development_script"
    },
    "ch16_scale_open_line_00": {
      "speaker": "梁萧",
      "text": "若一条性命也不能轻掷，又怎能以国族贵贱称量？",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step5",
        "06:PZ-07 scale",
        "04:SC-16-03"
      ],
      "status": "adapted_development_script"
    },
    "ch16_scale_open_line_01": {
      "speaker": "旁白",
      "text": "两人走进书库。铜门在身后缓缓止住。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step5",
        "06:PZ-07 scale",
        "04:SC-16-03"
      ],
      "status": "adapted_development_script"
    },
    "ch16_study_after_line_00": {
      "speaker": "旁白",
      "text": "十二次寒暖写进手札，三年过去。梁萧合上书页，铜仪上留下了磨亮的手痕。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step5"
      ],
      "status": "adapted_development_script"
    },
    "ch16_statue_memory_line_00": {
      "speaker": "旁白",
      "text": "异乡残像没有双臂。海潮的声息忽与钱塘旧日重叠；阿雪仍只在记忆里。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step6",
        "04:SC-16-04"
      ],
      "status": "adapted_development_script"
    },
    "ch16_ten_years_line_00": {
      "speaker": "旁白",
      "text": "辞别马拉加又过七载。旧袍泛白，手札渐厚；十年的风沙，没有抹去旧人的名字。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step6",
        "04:SC-16-04"
      ],
      "status": "adapted_development_script"
    },
    "ch16_eastward_line_00": {
      "speaker": "梁萧",
      "text": "山河有界，性命不该有贵贱。",
      "kind": "speech",
      "source_refs": [
        "06:MQ-16 Step6",
        "04:SC-16-04"
      ],
      "status": "adapted_development_script"
    },
    "ch16_eastward_line_01": {
      "speaker": "旁白",
      "text": "他收起算筹，转向万里关山。东方还有未了的故人。",
      "kind": "stage",
      "source_refs": [
        "06:MQ-16 Step6",
        "04:SC-16-04"
      ],
      "status": "adapted_development_script"
    }
  },
