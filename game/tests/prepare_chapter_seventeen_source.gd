extends SceneTree
## Ch16 source generated by legal model commands; not natural GUI evidence.
const Campaign=preload("res://scripts/campaign/campaign_state.gd")
const Driver=preload("res://tests/chapter_sixteen_driver.gd")
func _initialize()->void:call_deferred("run")
func run()->void:
 var source:=OS.get_environment("CH16_SOURCE");var destination:=OS.get_environment("CH17_SOURCE")
 if source.is_empty() or destination.is_empty():push_error("CH16_SOURCE and CH17_SOURCE required");quit(2);return
 var c=Campaign.new(JSON.parse_string(FileAccess.get_file_as_string("res://data/prologue.json")))
 var error:String=c.restore_persisted(JSON.parse_string(FileAccess.get_file_as_string(source)))
 if error!="" or not c.enter_registered_chapter(16):push_error("invalid source: "+error);quit(1);return
 var steps:=0
 for n in range(160):
  if c.state.finished:break
  if not Driver.advance(c,0):push_error("source stopped at "+c.current_token());quit(1);return
  steps+=1
 var encoded:Dictionary=c.prepare_persisted_save()
 if not c.state.finished or encoded.error!="":push_error("source did not finish/encode: "+encoded.error);quit(1);return
 DirAccess.make_dir_recursive_absolute(destination.get_base_dir())
 var file:=FileAccess.open(destination,FileAccess.WRITE);file.store_string(JSON.stringify(encoded.payload));file.close()
 print("Chapter seventeen source: %d steps, 0 failures; xp=%d"%[steps,c.actors.char_liang_xiao.xp])
 for id in ["char_liang_xiao","char_liu_yingying","char_feng_lian"]:
  var a:Dictionary=c.actors[id];print(id," hp=",a.get("hp",0),"/",a.get("max_hp",0)," mp=",a.get("mp",0),"/",a.get("max_mp",0)," skills=",a.get("skill_ranks",{}))
 quit(0)
