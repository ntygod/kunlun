extends "res://tests/test_chapter_three.gd"
const Bounded = preload("res://scripts/campaign/bounded_save_codec.gd")
var folder: String
func reject4(value: Variant, campaign: CampaignState, label: String) -> void:
 var before:=campaign.export_save()
 check(campaign.restore(value)!="","reject "+label)
 check(Bounded.equivalent(before,campaign.export_save()),"atomic "+label)
func write_file(path: String,text: String) -> void:
 var file:=FileAccess.open(path,FileAccess.WRITE);file.store_string(text);file.close()
func legacy_case(saved: Dictionary, label: String) -> CampaignState:
 var original:=Campaign.new(base)
 check(original.restore(saved)=="","legacy valid "+label)
 var migrated:=Campaign.new(base)
 check(migrated.restore_persisted(JSON.parse_string(JSON.stringify(saved)))=="","migration "+label)
 check(migrated.bounded_mode and migrated.export_save().version==4,"v4 mode "+label)
 check(Bounded.compare_live(original,migrated)=="","continuity "+label)
 var again:=Campaign.new(base)
 check(again.restore(JSON.parse_string(JSON.stringify(migrated.export_save())))=="","v4 replay "+label)
 check(Bounded.compare_live(migrated,again)=="","v4 continuity "+label)
 check(again.prior_campaign.is_empty(),"no nested campaign "+label)
 if again.active_chapter>=2:check(again.progress.events.is_empty(),"no completed chapter1 clicks "+label)
 if again.active_chapter==3:check(again.chapter_two.state.chronology.is_empty(),"no completed chapter2 clicks "+label)
 var directory:=folder+"/"+label
 DirAccess.make_dir_recursive_absolute(directory)
 var old_text:=JSON.stringify(saved,"\t")+"\n"
 write_file(directory+"/manual.json",old_text)
 var store:=Saves.new(directory)
 var disk:=Campaign.new(base)
 check(store.load_game(disk)=="","disk migration "+label)
 check(FileAccess.get_file_as_string(directory+"/manual.json")==old_text,"read leaves original bytes "+label)
 check(store.save_game(disk)=="","v4 replacement "+label)
 check(FileAccess.get_file_as_string(directory+"/manual.json.v%d.bak"%int(saved.version))==old_text,"exact original backup "+label)
 check(JSON.parse_string(FileAccess.get_file_as_string(directory+"/manual.json")).version==4,"new disk format "+label)
 return migrated
func run() -> void:
 base=JSON.parse_string(FileAccess.get_file_as_string("res://data/prologue.json"))
 folder="user://bounded_save_tests_"+str(Time.get_ticks_usec())
 DirAccess.make_dir_recursive_absolute(folder)
 var beginning:=Campaign.new(base)
 legacy_case(beginning.prologue.state.duplicate(true),"v1_open")
 var second:=chapter_two_ending(true)
 var v3two:=second.export_save()
 legacy_case(v3two.prior_campaign.prologue,"v1_end")
 legacy_case(v3two.prior_campaign,"v2_end")
 legacy_case(v3two,"v3_two_end")
 check(second.enter_chapter_three(),"real chapter3 begins")
 legacy_case(second.export_save(),"v3_three_open")
 while second.current_event().op!="puzzle":check(act_three(second,16),"reach tea")
 check(second.chapter_three.puzzle_input(second.current_token(),{"type":"tea_transfer","cup":0,"amount":1}).ok,"partial actual tea")
 var partial:=legacy_case(second.export_save(),"v3_tea_partial")
 check(partial.chapter_three.make_puzzle().get_view().state.cups==[1,0,0],"partial tea remains exact")
 var live:=partial.export_save()
 for value in [null,false,0,"",[],{}]:reject4(value,partial,"root type")
 for key in live:
  for value in [null,false,0,"",[],{}]:
   if Bounded.equivalent(live[key],value):continue
   var bad:=live.duplicate(true);bad[key]=value;reject4(bad,partial,"root field "+key)
 var bad:=live.duplicate(true);bad.version=5;reject4(bad,partial,"future version")
 bad=live.duplicate(true);bad.active_chapter=4;reject4(bad,partial,"unregistered chapter4")
 bad=live.duplicate(true);bad.prior_campaign=live;reject4(bad,partial,"recursive legacy payload")
 bad=live.duplicate(true);bad.archive.append(bad.archive[-1].duplicate(true));reject4(bad,partial,"duplicate archive")
 bad=live.duplicate(true);bad.archive.reverse();reject4(bad,partial,"out of order archive")
 bad=live.duplicate(true);bad.archive[2].milestones.pop_back();reject4(bad,partial,"missing completion")
 bad=live.duplicate(true);bad.archive[2].milestones.append(bad.archive[2].milestones[0]);reject4(bad,partial,"duplicate milestone")
 bad=live.duplicate(true);bad.archive[2].xp=99999;reject4(bad,partial,"external reward total")
 bad=live.duplicate(true);bad.archive[2].skills=["LX_A99"];reject4(bad,partial,"future skill")
 bad=live.duplicate(true);bad.archive[2].boundary_vitals.hp=1;reject4(bad,partial,"impossible suffix HP")
 bad=live.duplicate(true);bad.current.xp=99999;reject4(bad,partial,"injected current XP")
 bad=live.duplicate(true);bad.current.events.append({"kind":"complete","token":partial.current_token(),"proof":{"won":true}});reject4(bad,partial,"unearned current success")
 bad=live.duplicate(true);bad.current.navigation.position=[99999,0];reject4(bad,partial,"invalid current position")
 bad=live.duplicate(true);bad.current.events.resize(10001);reject4(bad,partial,"bounded current event limit")
 # Continue the real input stream after loading its v4 partial session.
 for action in [{"type":"tea_transfer","cup":1,"amount":1},{"type":"tea_transfer","cup":2,"amount":1},{"type":"submit"}]:
  partial.chapter_three.puzzle_input(partial.current_token(),action)
  second.chapter_three.puzzle_input(second.current_token(),action)
 while partial.current_event().op!="objective_battle":check(act_three(partial,16),"v4 continues to B01")
 var battle:=partial.chapter_three.make_objective_encounter()
 check(battle.set_command("char_liang_xiao","observe","char_ming_sanqiu")=="","B01 pending command")
 check(partial.chapter_three.save_objective_checkpoint(battle),"pending B01 checkpoint")
 var battle_copy:=Campaign.new(base);check(battle_copy.restore(partial.export_save())=="","v4 pending B01 restore")
 check(Bounded.equivalent(battle.snapshot(),battle_copy.chapter_three.make_objective_encounter().snapshot()),"pending B01 exact")
 while not second.state.finished:
  var advanced:=act_three(second,16)
  check(advanced,"legacy route completes")
  if not advanced:quit(1);return
 var terminal:=legacy_case(second.export_save(),"v3_three_end")
 var final:=terminal.export_save()
 check(final.archive.size()==4 and final.current.status=="archived","all completed chapters summarized")
 check(not JSON.stringify(final).contains("input_log") and not JSON.stringify(final).contains("chronology"),"terminal contains no historical clicks")
 check(terminal.chapter_three.state.chronology.is_empty() and terminal.chapter_three.state.puzzle_records.is_empty(),"completed current memory compacted")
 check(JSON.stringify(final).length()<JSON.stringify(second.export_save()).length()/4,"terminal substantial reduction")
 # A backup conflict or unwritable directory cannot mutate live state or old slot.
 var conflict:=folder+"/conflict";DirAccess.make_dir_recursive_absolute(conflict)
 var original_text:=JSON.stringify(v3two,"\t")+"\n"
 write_file(conflict+"/manual.json",original_text);write_file(conflict+"/manual.json.v3.bak","different old backup")
 var store:=Saves.new(conflict);var c:=Campaign.new(base);check(c.restore(v3two)=="","conflict legacy baseline")
 var before:=c.export_save()
 check(store.save_game(c)!="","different backup blocks replacement")
 check(Bounded.equivalent(before,c.export_save()),"failed save preserves legacy memory")
 check(FileAccess.get_file_as_string(conflict+"/manual.json")==original_text,"failed save preserves old bytes")
 check(FileAccess.get_file_as_string(conflict+"/manual.json.v3.bak")=="different old backup","existing backup never overwritten")
 write_file(folder+"/not_a_directory","blocked")
 store=Saves.new(folder+"/not_a_directory/child")
 check(store.save_game(c)!="","unwritable destination fails")
 check(Bounded.equivalent(before,c.export_save()),"write failure does not compact live state")
 # A v4 file cannot silently discard an invalid live gameplay table on save.
 terminal.actors.char_liang_xiao.skills.append("LX_A99")
 store=Saves.new(folder+"/invalid_live")
 check(store.save_game(terminal)!="","invalid live skill rejected before saving")
 check("LX_A99" in terminal.actors.char_liang_xiao.skills,"failed validation leaves live unchanged")
 check(not FileAccess.file_exists(folder+"/invalid_live/manual.json"),"invalid live does not create slot")
 print("Bounded saves: %d checks, %d failures"%[checks,failures])
 quit(1 if failures else 0)
